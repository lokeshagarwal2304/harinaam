# Harinaam Production Environment Variables
# In Vercel Project Settings > Environment Variables:
# Set NEXT_PUBLIC_API_BASE_URL to your deployed Laravel API URL (e.g. https://harinaam-api.up.railway.app/api/v1)

NEXT_PUBLIC_API_BASE_URL=https://api.harinaam.app/api/v1
NEXT_PUBLIC_APP_NAME="Harinaam"
NEXT_PUBLIC_DEFAULT_LANGUAGE=hi
